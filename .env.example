# Optional but STRONGLY recommended.
#
# Without these, the app calls Reddit's public www.reddit.com/*.json
# endpoints with no authentication. Reddit frequently blocks that traffic
# from servers/cloud IPs with "403: Blocked" or 429 rate limits.
#
# Setting these switches the app to Reddit's official OAuth API
# (oauth.reddit.com), which is far more reliable.
#
# How to get them (takes ~2 minutes, free):
# 1. Log in to Reddit, go to https://www.reddit.com/prefs/apps
# 2. Click "create another app..." at the bottom
# 3. Pick type "script", fill any name/description,
#    set "redirect uri" to http://localhost:3000
# 4. Copy the string under the app name (client ID) and the "secret" field
REDDIT_CLIENT_ID="your_client_id_here"
REDDIT_CLIENT_SECRET="your_client_secret_here"

# Reddit requires a unique, descriptive User-Agent. Replace with your own
# Reddit username. Format: platform:app_id:version (by /u/username)
REDDIT_USER_AGENT="web:litnuke-x-anuma-tracker:1.0.0 (by /u/your_reddit_username)"

# ============================================================
# Dashboard login (protects this app itself from other people)
# ============================================================
# If both are left empty, login is DISABLED and anyone who can reach this
# server can open the dashboard — fine for local-only use, not fine if you
# ever expose this to a network. Set both to require a login.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change_this_to_a_strong_password"

# Used to sign login sessions. Set this to any long random string and never
# share it. If left empty, a random one is generated on every server start,
# which means everyone gets logged out each time you restart the server.
SESSION_SECRET="change_this_to_a_long_random_string"

# ============================================================
# Data storage location (tracked accounts & activities)
# ============================================================
# Defaults to a "data" folder next to the server. This is where your
# accounts and activities are saved — this is what makes the same data show
# up on any browser/device, instead of localStorage's per-browser storage.
#
# IMPORTANT if deploying to Railway (or similar container hosts): the
# filesystem resets on every redeploy unless you attach a persistent Volume.
# In Railway: Settings → Volumes → add a volume, mount it at e.g. /data,
# then set DATA_DIR=/data below so your data survives redeploys.
DATA_DIR="./data"

